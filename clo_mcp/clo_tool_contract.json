[
  {
    "name": "clo_status",
    "description": "Check whether CLO is running and the in-CLO bridge is reachable. Returns instructions when it is not.",
    "inputSchema": {
      "properties": {},
      "title": "clo_statusArguments",
      "type": "object"
    }
  },
  {
    "name": "clo_launch",
    "description": "Launch CLO (macOS). Passing -python clo_bridge.py is attempted, but CLO 2026.1 did not run it at startup in testing,\n    so after CLO is up start the bridge with the menu item Plugins > start_bridge (or ask the user to click it).",
    "inputSchema": {
      "properties": {
        "with_bridge": {
          "default": true,
          "title": "With Bridge",
          "type": "boolean"
        }
      },
      "title": "clo_launchArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "clo_launchOutput",
      "type": "object"
    }
  },
  {
    "name": "clo_stop_bridge",
    "description": "Stop the bridge loop inside CLO (frees the Python editor; CLO keeps running).",
    "inputSchema": {
      "properties": {},
      "title": "clo_stop_bridgeArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "clo_stop_bridgeOutput",
      "type": "object"
    }
  },
  {
    "name": "clo_run_python",
    "description": "Run Python inside CLO with the CLO API modules pre-imported (import_api, export_api, fabric_api, pattern_api,\n    utility_api, rest_api, ApiTypes). A single expression returns its value; otherwise assign to `result`.\n    stdout is captured. Coordinates: mm, Y up. Example: pattern_api.GetPatternCount()",
    "inputSchema": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "code"
      ],
      "title": "clo_run_pythonArguments",
      "type": "object"
    }
  },
  {
    "name": "clo_api_search",
    "description": "Search names and docstrings in the running CLO API. Requires the bridge. Use clo_api_catalog for pagination.",
    "inputSchema": {
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "limit": {
          "default": 40,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "clo_api_searchArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "clo_api_searchOutput",
      "type": "object"
    }
  },
  {
    "name": "clo_api_doc",
    "description": "Read live documentation for a CLO function. Prefer a qualified name such as pattern_api.GetPatternCount.",
    "inputSchema": {
      "properties": {
        "function_name": {
          "title": "Function Name",
          "type": "string"
        }
      },
      "required": [
        "function_name"
      ],
      "title": "clo_api_docArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "clo_api_docOutput",
      "type": "object"
    }
  },
