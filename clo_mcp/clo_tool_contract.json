  {
    "name": "clo_api_describe",
    "description": "Live docstring/overloads and class fields for a qualified name, e.g. pattern_api.GetPatternCount or ApiTypes.ImportExportOption. Documents the running version.",
    "inputSchema": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
