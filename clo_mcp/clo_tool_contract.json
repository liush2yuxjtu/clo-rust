        }
      },
      "required": [
        "pattern"
      ],
      "title": "pattern_infoArguments",
      "type": "object"
    }
  },
  {
    "name": "pattern_create",
    "description": "Create a pattern piece from outline points [[x, y, type], ...] in mm (Y up). type 0 = corner (default),\n    2 = spline curve point, 3 = bezier control point. Lines are numbered by corner order (line i joins corner i to\n    i+1). Optionally place it on an arrangement point (see arrangement_points).",
    "inputSchema": {
      "properties": {
        "points": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "arrangement": {
          "default": "",
          "title": "Arrangement",
          "type": "string"
        }
      },
      "required": [
        "points"
      ],
      "title": "pattern_createArguments",
      "type": "object"
    }
  },
  {
    "name": "pattern_delete",
    "description": "Delete pieces by name or index.",
    "inputSchema": {
      "properties": {
        "patterns": {
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        }
      },
      "required": [
        "patterns"
      ],
      "title": "pattern_deleteArguments",
      "type": "object"
    }
  },
  {
    "name": "pattern_set_arrangement",
    "description": "Place a piece on an avatar arrangement point (e.g. Body_Front_Center_3, Leg_Skirt_Back, Arm_Outside_2_L).",
    "inputSchema": {
      "properties": {
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "point": {
          "title": "Point",
          "type": "string"
        }
      },
      "required": [
        "pattern",
        "point"
      ],
      "title": "pattern_set_arrangementArguments",
      "type": "object"
    }
  },
  {
    "name": "pattern_edit_points",
    "description": "Move outline points of a piece. moves: [{\"point\": i, \"x\": .., \"y\": ..}] absolute or [{\"point\": i, \"dx\": .., \"dy\": ..}]\n    relative (mm, 2D pattern space). Use pattern_info to see point indices/positions. Only corner points are indexed;\n    curve (spline) points on an edge stay where they are, so moving corners of a curved hem distorts it. For built\n    garments prefer garment_rebuild({\"length\": ...}); use this for straight-edged pieces or small tweaks, then simulate.",
    "inputSchema": {
      "properties": {
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "moves": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Moves",
          "type": "array"
        }
      },
      "required": [
        "pattern",
        "moves"
      ],
      "title": "pattern_edit_pointsArguments",
      "type": "object"
    }
  },
  {
    "name": "pattern_ops",
    "description": "Piece operations. op: rename{name}, move_2d{x,y|dx,dy}, flip{horizontal,each}, copy{dx,dy}, symmetry{with_sewing},\n    unfold{line,half_symmetry}, layer{layer}, particle_distance{mm}, freeze{on}, hide{on}, strengthen{on},\n    elastic{line,on,total_length,strength}, shirring{line,on}, delete_line{line}, delete_point{point}.",
    "inputSchema": {
      "properties": {
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Args"
        }
      },
      "required": [
        "pattern",
        "op"
      ],
      "title": "pattern_opsArguments",
      "type": "object"
    }
  },
  {
    "name": "sew",
    "description": "Sew line_a of pattern_a to line_b of pattern_b (segment sewing). Directions follow each line's point order;\n    when the two lines run in opposite physical directions set dir_b=False (e.g. front right side <-> back left side\n    with clockwise outlines). Check the result with simulate + snapshot; there is no API to remove a seam, so save a\n    checkpoint first.",
    "inputSchema": {
      "properties": {
        "pattern_a": {
          "title": "Pattern A",
          "type": "string"
        },
        "line_a": {
          "title": "Line A",
          "type": "integer"
        },
        "pattern_b": {
          "title": "Pattern B",
          "type": "string"
        },
        "line_b": {
          "title": "Line B",
          "type": "integer"
        },
        "dir_a": {
          "default": true,
          "title": "Dir A",
          "type": "boolean"
        },
        "dir_b": {
          "default": true,
          "title": "Dir B",
          "type": "boolean"
        }
      },
      "required": [
        "pattern_a",
        "line_a",
        "pattern_b",
        "line_b"
      ],
      "title": "sewArguments",
      "type": "object"
    }
  },
